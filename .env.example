# Supabase project (Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Sign-In (Google Cloud Console -> Credentials). The web client id also powers the web app's
# Google button / One Tap; add the site to that client's Authorized JavaScript origins.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com

# Web app only: show "Continue with Google" (Supabase OAuth redirect). Set to true once the Google
# provider is enabled in Supabase (Authentication -> Providers -> Google, using the web client id
# and secret) and the site URL is in Authentication -> URL Configuration -> Redirect URLs.
EXPO_PUBLIC_GOOGLE_WEB_ENABLED=false

# Public invite link base; the token is appended as /<token>.
# Native: universal-link domain in production, the app scheme works for dev.
# Web: must be an https link, e.g. https://rx-vault.expo.app/invite . If unset or not http(s),
# the web app uses its own address + /invite.
EXPO_PUBLIC_INVITE_BASE_URL=prescriptionvault://invite

# Privacy policy / terms URLs shown in Settings and on sign-in
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms

# Support contact shown in Settings
EXPO_PUBLIC_SUPPORT_EMAIL=

# Must match Supabase Auth > Email OTP length (local config.toml uses 6)
EXPO_PUBLIC_OTP_LENGTH=6

# Crash reports (sentry.io -> project -> Client Keys). Leave empty to turn Sentry off.
EXPO_PUBLIC_SENTRY_DSN=
